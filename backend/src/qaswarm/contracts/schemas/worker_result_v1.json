{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raone.dev/schemas/worker_result/1.0",
  "title": "Worker result v1 (LLD: Worker result schema)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "attempt_no", "worker_run_id", "exit", "tool", "summary",
    "results_ref", "evidence_refs", "truncated", "redactions_applied", "resource_usage"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$" },
    "attempt_no": { "type": "integer", "minimum": 1 },
    "worker_run_id": { "type": "string", "maxLength": 40 },
    "exit": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "signal", "duration_ms"],
      "properties": {
        "code": { "type": "integer" },
        "signal": { "type": ["string", "null"], "maxLength": 20 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "image_digest"],
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "version": { "type": "string", "maxLength": 40 },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["executed", "passed", "failed", "skipped", "errors"],
      "properties": {
        "executed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "results_ref": { "type": "string", "maxLength": 4096 },
    "evidence_refs": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 4096 } },
    "truncated": { "type": "boolean" },
    "redactions_applied": { "type": "integer", "minimum": 0 },
    "resource_usage": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_seconds", "max_rss_mib", "output_bytes"],
      "properties": {
        "cpu_seconds": { "type": "number", "minimum": 0 },
        "max_rss_mib": { "type": "number", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0, "maximum": 52428800 }
      }
    }
  }
}
