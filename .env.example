# Autonomous QA Swarm — every AQS_* setting with safe local defaults. No secrets here.
# Copy to .env for local development. Real credentials come from the environment or the secrets broker.

# Database (Compose service). Never commit a real password.
AQS_DATABASE_URL=postgresql+psycopg://qaswarm:qaswarm-dev-only@localhost:5432/qaswarm
# Separate database used by integration tests (tables are created and dropped). Unset = tests skipped.
AQS_TEST_DATABASE_URL=postgresql+psycopg://qaswarm:qaswarm-dev-only@localhost:5432/qaswarm_test

# API
AQS_CORS_ORIGINS=["http://localhost:5173"]
AQS_LOG_LEVEL=INFO
# Dev-only header auth (X-Dev-User / X-Dev-Role). Must be false outside local development.
AQS_DEV_AUTH=true
AQS_PROBLEM_TYPE_BASE=https://qa-swarm.dev/problems/

# Repository intake: git ls-remote pins ref -> commit SHA (phase 2). DNS check rejects private/loopback hosts.
AQS_GIT_HOST_ALLOWLIST=["github.com","gitlab.com"]
AQS_INTAKE_DNS_CHECK=true
AQS_INTAKE_TIMEOUT_SECONDS=60
# Dev only: allow https://fixtures.local/local/<name> repositories served from AQS_FIXTURES_DIR (refs are directories).
AQS_DEV_FIXTURE_REPOS=false
AQS_FIXTURES_DIR=../exec/fixtures

# Execution Service (phase 2). The token is shared with exec hosts; unset = /internal/v1/exec/* answers 503.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))" — never commit a real value.
AQS_EXEC_TOKEN=
# Content-addressed evidence store (redacted before hashing). Inline content served up to this many bytes.
AQS_EVIDENCE_DIR=./data/evidence
AQS_EVIDENCE_INLINE_MAX_BYTES=1048576
# Scheduler: run inside the API process (single-node dev) or as `python -m qaswarm.workflow.scheduler`.
AQS_SCHEDULER_INTERVAL_SECONDS=2
AQS_EMBEDDED_SCHEDULER=false
# Exec worker inside the API process (dev only; production exec hosts are separate machines, see exec/README.md).
AQS_EMBEDDED_EXEC_WORKER=false
AQS_EXEC_CONTROL_PLANE_URL=http://127.0.0.1:8000
# SubprocessRuntime is NOT a sandbox. Keep false unless the host is disposable; pytest engine is skipped otherwise.
AQS_EXEC_ALLOW_UNSANDBOXED_CODE_EXECUTION=false

# Job and task defaults (LLD)
AQS_JOB_WALL_CLOCK_SECONDS=14400
AQS_JOB_WALL_CLOCK_MAX_SECONDS=43200
AQS_TASK_WALL_CLOCK_SECONDS=1800
AQS_TASK_WALL_CLOCK_MAX_SECONDS=7200
AQS_LEASE_TTL_SECONDS=90
AQS_HEARTBEAT_SECONDS=30
AQS_TASK_MAX_RETRIES=2
AQS_BACKOFF_SECONDS=[30,120]
AQS_BACKOFF_JITTER=0.2
AQS_IDEMPOTENCY_TTL_HOURS=24
AQS_SSE_HEARTBEAT_SECONDS=15
